\@writefile{lot}{\contentsline {table}{\numberline {3.3}{\ignorespaces Visit structure and turnaround time (TTT) of the event log. Approach: Gate In to the start of the first stop; exit: end of the last stop to Gate Out; transfer: time between stops. Gate events are instantaneous, so the four parts add up to the TTT. Delay-peak hours: Gate-In hours with at least 20 visits and a median TTT of at least 37 minutes, the 90th percentile of the training hours.}}{28}{table.caption.18}\protected@file@percent }
\newlabel{tab:obs_descriptives}{{3.3}{28}{Visit structure and turnaround time (TTT) of the event log. Approach: Gate In to the start of the first stop; exit: end of the last stop to Gate Out; transfer: time between stops. Gate events are instantaneous, so the four parts add up to the TTT. Delay-peak hours: Gate-In hours with at least 20 visits and a median TTT of at least 37 minutes, the 90th percentile of the training hours}{table.caption.18}{}}
