\contentsline {chapter}{\numberline {8}Conclusion}{107}{chapter.8}%
\contentsline {section}{\numberline {8.1}Answers to the Research Questions}{107}{section.8.1}%
\contentsline {paragraph}{RQ1: Which discovery and rule treatment yields a sound, executable control-flow model that preserves the observed truck-visit behaviour, and do conformance metrics anticipate its behaviour in simulation?}{107}{section.8.1}%
\contentsline {paragraph}{RQ2: To what extent does the ProSiT simulation reproduce truck turnaround time and its response to load, and which components explain the discrepancies?}{108}{section.8.1}%
\contentsline {paragraph}{RQ3: To what extent can the simulation be used to analyse a load-aware block allocation for deliveries, and what does it indicate about the effect on turnaround time?}{108}{section.8.1}%
