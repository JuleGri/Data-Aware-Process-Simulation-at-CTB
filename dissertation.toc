\contentsline {chapter}{\numberline {8}Conclusion}{114}{chapter.8}%
\contentsline {section}{\numberline {8.1}Answers to the Research Questions}{114}{section.8.1}%
\contentsline {paragraph}{RQ1. Which discovery and rule treatment yields a sound, executable control-flow model that preserves the observed truck-visit behaviour, and do conformance metrics anticipate its behaviour in simulation?}{114}{section.8.1}%
\contentsline {paragraph}{RQ2. To what extent does the ProSiT simulation reproduce truck turnaround time and its response to load, and which components explain the discrepancies?}{115}{section.8.1}%
\contentsline {paragraph}{RQ3. To what extent can the simulation be used to evaluate a load-aware block allocation for deliveries, and what does it indicate about the effect on turnaround time?}{115}{section.8.1}%
\contentsline {section}{\numberline {8.2}Contributions}{115}{section.8.2}%
\contentsline {paragraph}{(C1) Conformance does not establish suitability for simulation.}{115}{section.8.2}%
\contentsline {paragraph}{(C2) An improved aggregate timing does not establish suitability for congestion-sensitive decisions.}{116}{section.8.2}%
\contentsline {paragraph}{(C3) A conditional assessment of a load-aware block allocation.}{116}{section.8.2}%
\contentsline {section}{\numberline {8.3}Limitations}{116}{section.8.3}%
\contentsline {section}{\numberline {8.4}Future Work}{117}{section.8.4}%
