\contentsline {chapter}{\numberline {8}Conclusion}{111}{chapter.8}%
\contentsline {section}{\numberline {8.1}Answers to the Research Questions}{111}{section.8.1}%
\contentsline {paragraph}{RQ1. Which discovery and rule treatment yields a sound, executable control-flow model that preserves the observed truck-visit behaviour, and do conformance metrics anticipate its behaviour in simulation?}{111}{section.8.1}%
\contentsline {paragraph}{RQ2. To what extent does the ProSiT simulation reproduce truck turnaround time and its response to load, and which components explain the discrepancies?}{112}{section.8.1}%
\contentsline {paragraph}{RQ3. To what extent can the simulation be used to evaluate a load-aware block allocation for deliveries, and what does it indicate about the effect on turnaround time?}{112}{section.8.1}%
\contentsline {section}{\numberline {8.2}Contributions}{112}{section.8.2}%
\contentsline {paragraph}{(C1) A domain-constrained simulation model of CTB truck visits.}{112}{section.8.2}%
\contentsline {paragraph}{(C2) An empirical analysis of simulation errors and congestion sensitivity.}{113}{section.8.2}%
\contentsline {paragraph}{(C3) A conditional evaluation of load-aware block allocation.}{113}{section.8.2}%
