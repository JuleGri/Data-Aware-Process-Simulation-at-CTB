\addvspace {10\p@ }
\contentsline {figure}{\numberline {A.1}{\ignorespaces Hourly arrivals (top) and median turnaround time by Gate-In hour (bottom) for the training and test periods. Dots mark arrival peaks and delay peaks. Dashed lines show the thresholds of 165 arrivals and 37 minutes. The vertical line marks the start of the test period.}}{103}{figure.caption.55}%
\contentsline {figure}{\numberline {A.2}{\ignorespaces Mean turnaround time by Gate-In hour, split into approach, stop intervals, transfer and exit. Training weekdays.}}{104}{figure.caption.56}%
\contentsline {figure}{\numberline {A.3}{\ignorespaces Median and P90 of the turnaround time by the number of trucks in the terminal at Gate In, in classes of 20. Training, classes with at least 50 visits.}}{104}{figure.caption.57}%
\contentsline {figure}{\numberline {A.4}{\ignorespaces Median stop interval by the number of trucks with an open interval at the same handling unit when the stop starts. Training.}}{105}{figure.caption.58}%
