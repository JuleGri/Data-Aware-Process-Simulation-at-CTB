\newlabel{tab:rq2_nets}{{D.3}{119}{The final configuration with each net of the E3 contrasts, against the test log, means over five seeds. Times in minutes. Overlap: share of multi-stop visits with overlapping stops. TTT at 150+: median TTT of the visits with 150 or more trucks in the terminal at Gate In}{table.caption.70}{}}
\@writefile{toc}{\contentsline {section}{\numberline {D.3}The Final Configuration Against the Observed Logs}{119}{section.D.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {D.4}{\ignorespaces Key values of the final configuration against the observed logs (replayed visits and observed blocks, means over five seeds). Times in minutes; CTD: cycle-time distance; Spearman: hourly arrivals against hourly median TTT; Max at block: largest number of trucks at one block at once (the log records 4 because of short recording overlaps, Section~\ref {sec:exp_e4_mechanisms}).}}{119}{table.caption.71}\protected@file@percent }
\newlabel{tab:sim_kpis}{{D.4}{119}{Key values of the final configuration against the observed logs (replayed visits and observed blocks, means over five seeds). Times in minutes; CTD: cycle-time distance; Spearman: hourly arrivals against hourly median TTT; Max at block: largest number of trucks at one block at once (the log records 4 because of short recording overlaps, Section~\ref {sec:exp_e4_mechanisms})}{table.caption.71}{}}
