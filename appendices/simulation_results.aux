\@writefile{toc}{\contentsline {section}{\numberline {D.1}Choice and Necessity of the Changes}{117}{section.D.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {D.1}{\ignorespaces Choice of the final configuration on the training period (E4f): replayed training visits with their observed blocks, compared with the training log, means over five seeds. Admissible: no rule violation and at most three trucks at a block at once. The configuration with the smallest sum of the profile gaps is chosen ($\leftarrow $). Gaps and CTD in minutes.}}{117}{table.caption.68}\protected@file@percent }
\newlabel{tab:rq2_selection}{{D.1}{117}{Choice of the final configuration on the training period (E4f): replayed training visits with their observed blocks, compared with the training log, means over five seeds. Admissible: no rule violation and at most three trucks at a block at once. The configuration with the smallest sum of the profile gaps is chosen ($\leftarrow $). Gaps and CTD in minutes}{table.caption.68}{}}
\@writefile{lot}{\contentsline {table}{\numberline {D.2}{\ignorespaces Final configuration with each change reversed alone, with other block allocations, other arrival intensities and without replay (E4e), against the test log, means over five seeds. $^{*}$Only the 2,393 visits of the first day, because the queue of the learned block choice grows without bound. Med., P90: median and P90 of the TTT; CTD: cycle-time distance; Appr., Stops: mean approach and stop time per visit (all in minutes). Top bl.: share of the RMG stops at the busiest block in \%. Max: largest number of trucks at one block at once in any seed. Spear.: Spearman correlation of hourly arrivals and hourly median TTT. G-appr., G-stop, G-WIP: profile gaps for the approach by trucks at the block, the RMG stop duration by other trucks at the block and the TTT by trucks in the terminal (minutes).}}{118}{table.caption.69}\protected@file@percent }
\newlabel{tab:rq2_loo}{{D.2}{118}{Final configuration with each change reversed alone, with other block allocations, other arrival intensities and without replay (E4e), against the test log, means over five seeds. $^{*}$Only the 2,393 visits of the first day, because the queue of the learned block choice grows without bound. Med., P90: median and P90 of the TTT; CTD: cycle-time distance; Appr., Stops: mean approach and stop time per visit (all in minutes). Top bl.: share of the RMG stops at the busiest block in \%. Max: largest number of trucks at one block at once in any seed. Spear.: Spearman correlation of hourly arrivals and hourly median TTT. G-appr., G-stop, G-WIP: profile gaps for the approach by trucks at the block, the RMG stop duration by other trucks at the block and the TTT by trucks in the terminal (minutes)}{table.caption.69}{}}
