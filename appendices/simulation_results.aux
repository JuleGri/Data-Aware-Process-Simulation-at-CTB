\@writefile{toc}{\contentsline {section}{\numberline {D.1}Stops per Visit in E3}{114}{section.D.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {D.1}{\ignorespaces Number of stops per visit: training log against the simulation of HM 0.7 (E3, means over five seeds of 32,014 visits). With the stop guard every truck performs its planned number of stops; without it, the learned routing alone reproduces the distribution almost as closely.}}{114}{table.caption.53}\protected@file@percent }
\newlabel{tab:rq1_e3_stopcount}{{D.1}{114}{Number of stops per visit: training log against the simulation of HM 0.7 (E3, means over five seeds of 32,014 visits). With the stop guard every truck performs its planned number of stops; without it, the learned routing alone reproduces the distribution almost as closely}{table.caption.53}{}}
\@writefile{toc}{\contentsline {section}{\numberline {D.2}Measures and Configurations of E4}{115}{section.D.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {D.2}{\ignorespaces Measures of operational validity in E4. For each load profile in P4, the \emph  {profile gap} is the mean absolute difference of the simulated medians to the observed ones over the bins.}}{115}{table.caption.54}\protected@file@percent }
\newlabel{tab:exp_e4_measures}{{D.2}{115}{Measures of operational validity in E4. For each load profile in P4, the \emph {profile gap} is the mean absolute difference of the simulated medians to the observed ones over the bins}{table.caption.54}{}}
\@writefile{lot}{\contentsline {table}{\numberline {D.3}{\ignorespaces Configurations of E4. ProSiT: component as fitted in E3. No self-count: retrained without counting the stop in its own queue. Lane free: waiting measured from the moment a lane became free. Whole delay: waiting measured from enabling to start. Every configuration from b3 on, and the baseline a0, is also run with an exact count of the activities in progress (suffix x, see the design decisions).}}{116}{table.caption.55}\protected@file@percent }
\newlabel{tab:exp_e4_configs}{{D.3}{116}{Configurations of E4. ProSiT: component as fitted in E3. No self-count: retrained without counting the stop in its own queue. Lane free: waiting measured from the moment a lane became free. Whole delay: waiting measured from enabling to start. Every configuration from b3 on, and the baseline a0, is also run with an exact count of the activities in progress (suffix x, see the design decisions)}{table.caption.55}{}}
\@writefile{toc}{\contentsline {section}{\numberline {D.3}Choice and Necessity of the Changes}{117}{section.D.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {D.4}{\ignorespaces Choice of the final configuration on the training period (E4f): replayed training visits with their observed blocks, compared with the training log, means over five seeds. Admissible: no rule violation and at most three trucks at a block at once. The configuration with the smallest sum of the profile gaps is chosen ($\leftarrow $). Gaps and CTD in minutes.}}{117}{table.caption.56}\protected@file@percent }
\newlabel{tab:rq2_selection}{{D.4}{117}{Choice of the final configuration on the training period (E4f): replayed training visits with their observed blocks, compared with the training log, means over five seeds. Admissible: no rule violation and at most three trucks at a block at once. The configuration with the smallest sum of the profile gaps is chosen ($\leftarrow $). Gaps and CTD in minutes}{table.caption.56}{}}
\@writefile{lot}{\contentsline {table}{\numberline {D.5}{\ignorespaces Final configuration with each change reversed alone, with other block allocations, other arrival intensities and without replay (E4e), against the test log, means over five seeds. $^{*}$Only the 2,393 visits of the first day, because the queue of the learned block choice grows without bound. Med., P90: median and P90 of the TTT; CTD: cycle-time distance; Appr., Stops: mean approach and stop time per visit (all in minutes). Top bl.: share of the RMG stops at the busiest block in \%. Max: largest number of trucks at one block at once in any seed. Spear.: Spearman correlation of hourly arrivals and hourly median TTT. G-appr., G-stop, G-WIP: profile gaps for the approach by trucks at the block, the RMG stop duration by other trucks at the block and the TTT by trucks in the terminal (minutes).}}{118}{table.caption.57}\protected@file@percent }
\newlabel{tab:rq2_loo}{{D.5}{118}{Final configuration with each change reversed alone, with other block allocations, other arrival intensities and without replay (E4e), against the test log, means over five seeds. $^{*}$Only the 2,393 visits of the first day, because the queue of the learned block choice grows without bound. Med., P90: median and P90 of the TTT; CTD: cycle-time distance; Appr., Stops: mean approach and stop time per visit (all in minutes). Top bl.: share of the RMG stops at the busiest block in \%. Max: largest number of trucks at one block at once in any seed. Spear.: Spearman correlation of hourly arrivals and hourly median TTT. G-appr., G-stop, G-WIP: profile gaps for the approach by trucks at the block, the RMG stop duration by other trucks at the block and the TTT by trucks in the terminal (minutes)}{table.caption.57}{}}
\@writefile{toc}{\contentsline {section}{\numberline {D.4}Other Nets Under the Final Configuration}{118}{section.D.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {D.6}{\ignorespaces The final configuration with each net of the E3 contrasts, against the test log, means over five seeds. Times in minutes. Overlap: share of multi-stop visits with overlapping stops. TTT at 150+: median TTT of the visits with 150 or more trucks in the terminal at Gate In.}}{119}{table.caption.58}\protected@file@percent }
\newlabel{tab:rq2_nets}{{D.6}{119}{The final configuration with each net of the E3 contrasts, against the test log, means over five seeds. Times in minutes. Overlap: share of multi-stop visits with overlapping stops. TTT at 150+: median TTT of the visits with 150 or more trucks in the terminal at Gate In}{table.caption.58}{}}
