\citation{burke2020stochasticPD,mannhardt2023stochasticProcessesModelling}
\@writefile{lot}{\contentsline {table}{\numberline {C.1}{\ignorespaces Comparison of the three admissible nets, each repaired, rewritten without silent transitions, with the stop guard on the visible transitions; mean over five seeds with [minimum, maximum]. Prec.: ETConformance on the rewritten net (training). Gate: no visit without stop, no overlapping stops of one truck, at most four stops, in every seed. TVD: total-variation distance to the training log (sequences; number of stops per visit). Overr.: guard overrides per run. Unseen: generated visits whose sequence does not occur in the training log. Right: against the test log. Observed test log: TTT median 33, P90 75 minutes.}}{111}{table.caption.51}\protected@file@percent }
\newlabel{tab:app_rewritten_matrix}{{C.1}{111}{Comparison of the three admissible nets, each repaired, rewritten without silent transitions, with the stop guard on the visible transitions; mean over five seeds with [minimum, maximum]. Prec.: ETConformance on the rewritten net (training). Gate: no visit without stop, no overlapping stops of one truck, at most four stops, in every seed. TVD: total-variation distance to the training log (sequences; number of stops per visit). Overr.: guard overrides per run. Unseen: generated visits whose sequence does not occur in the training log. Right: against the test log. Observed test log: TTT median 33, P90 75 minutes}{table.caption.51}{}}
