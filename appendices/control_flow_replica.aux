\@writefile{lot}{\contentsline {table}{\numberline {C.3}{\ignorespaces $2\times 2$ contrast for HM 0.7 in E3 (Table~\ref {tab:exp_e3_contrast}): original net (22 places, 45 transitions, 34 silent) or the same language rewritten without silent transitions, stop guard on the visible transitions off or on; mean over five seeds, against the training log. Overlap: share of the multi-stop visits with overlapping stops. Unseen: generated visits whose sequence does not occur in the training log. Guard: draws whose weights the guard changed, and draws it could not decide (overrides), per run.}}{123}{table.caption.76}\protected@file@percent }
\newlabel{tab:app_rewritten_2x2_hm}{{C.3}{123}{$2\times 2$ contrast for HM 0.7 in E3 (Table~\ref {tab:exp_e3_contrast}): original net (22 places, 45 transitions, 34 silent) or the same language rewritten without silent transitions, stop guard on the visible transitions off or on; mean over five seeds, against the training log. Overlap: share of the multi-stop visits with overlapping stops. Unseen: generated visits whose sequence does not occur in the training log. Guard: draws whose weights the guard changed, and draws it could not decide (overrides), per run}{table.caption.76}{}}
\@writefile{toc}{\contentsline {section}{\numberline {C.2}Control-Flow Replica}{123}{section.C.2}\protected@file@percent }
\newlabel{app:replica_token_game}{{C.2}{123}{Control-Flow Replica}{section.C.2}{}}
\@writefile{toc}{\contentsline {paragraph}{The weights do not see the marking.}{123}{table.caption.78}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {C.4}{\ignorespaces Effect of the rule treatment on the simulated visits (E3), test period, means over five seeds. Original net: IM 0.0 as discovered (parallel branches that silent transitions can skip). Repaired net: language restricted to rules 3 and 5, rewritten without silent transitions. Guard: stop guard on the visible transitions. Control: the unrepaired language rewritten without silent transitions. Overlapping stops: share of the visits with more than one stop. Unseen sequences: generated visits whose sequence never occurs in the training log. TVD: total-variation distance to the distribution of the observed test log (0 = identical).}}{124}{table.caption.77}\protected@file@percent }
\newlabel{tab:app_rewritten_2x2_im}{{C.4}{124}{Effect of the rule treatment on the simulated visits (E3), test period, means over five seeds. Original net: IM 0.0 as discovered (parallel branches that silent transitions can skip). Repaired net: language restricted to rules 3 and 5, rewritten without silent transitions. Guard: stop guard on the visible transitions. Control: the unrepaired language rewritten without silent transitions. Overlapping stops: share of the visits with more than one stop. Unseen sequences: generated visits whose sequence never occurs in the training log. TVD: total-variation distance to the distribution of the observed test log (0 = identical)}{table.caption.77}{}}
\@writefile{lot}{\contentsline {table}{\numberline {C.5}{\ignorespaces Control-flow replica of ProSiT's routing (token game, no time, no resources): every training visit is simulated with its own manifest, three seeds, measures against the training log; the sequence TVD of a row varies by at most 0.006 between the seeds. Routing weights: P(transition fires $\mid $ enabled), estimated by counting on the aligned training log; ``data + history'' uses the planned stops, the flow type and the counts of the activities done so far, as ProSiT's trees do; ``marking'' adds the state of the net. Guard: local = the stop guard of this thesis; look-ahead = also masks silent steps after which the plan cannot be completed; rejection = simulate without guard and keep only visits with the planned number of stops. Rewritten: the same language without silent transitions.}}{125}{table.caption.78}\protected@file@percent }
\newlabel{tab:app_control_flow_replica}{{C.5}{125}{Control-flow replica of ProSiT's routing (token game, no time, no resources): every training visit is simulated with its own manifest, three seeds, measures against the training log; the sequence TVD of a row varies by at most 0.006 between the seeds. Routing weights: P(transition fires $\mid $ enabled), estimated by counting on the aligned training log; ``data + history'' uses the planned stops, the flow type and the counts of the activities done so far, as ProSiT's trees do; ``marking'' adds the state of the net. Guard: local = the stop guard of this thesis; look-ahead = also masks silent steps after which the plan cannot be completed; rejection = simulate without guard and keep only visits with the planned number of stops. Rewritten: the same language without silent transitions}{table.caption.78}{}}
\@writefile{toc}{\contentsline {paragraph}{Silent transitions alone are not the cause.}{125}{table.caption.78}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A guard has to act where the decision is taken.}{125}{table.caption.78}\protected@file@percent }
