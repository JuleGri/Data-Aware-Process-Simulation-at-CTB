\@writefile{toc}{\contentsline {section}{\numberline {C.2}Control-Flow Replica}{111}{section.C.2}\protected@file@percent }
\newlabel{app:replica_token_game}{{C.2}{111}{Control-Flow Replica}{section.C.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {C.2}{\ignorespaces Control-flow replica of ProSiT's routing (token game, no time, no resources): every training visit is simulated with its own case attributes, three seeds, measures against the training log; the sequence TVD of a row varies by at most 0.006 between the seeds. Routing weights: P(transition fires $\mid $ enabled), estimated by counting on the aligned training log; ``data + history'' uses the planned stops, the flow type and the counts of the activities done so far, as ProSiT's trees do; ``marking'' adds the state of the net. Guard: local = the simple guard on visible stops and Gate Out; look-ahead = also masks silent steps after which the plan cannot be completed; rejection = simulate without guard and keep only visits with the planned number of stops. Rewritten: the same language without silent transitions.}}{112}{table.caption.52}\protected@file@percent }
\newlabel{tab:app_control_flow_replica}{{C.2}{112}{Control-flow replica of ProSiT's routing (token game, no time, no resources): every training visit is simulated with its own case attributes, three seeds, measures against the training log; the sequence TVD of a row varies by at most 0.006 between the seeds. Routing weights: P(transition fires $\mid $ enabled), estimated by counting on the aligned training log; ``data + history'' uses the planned stops, the flow type and the counts of the activities done so far, as ProSiT's trees do; ``marking'' adds the state of the net. Guard: local = the simple guard on visible stops and Gate Out; look-ahead = also masks silent steps after which the plan cannot be completed; rejection = simulate without guard and keep only visits with the planned number of stops. Rewritten: the same language without silent transitions}{table.caption.52}{}}
\@writefile{toc}{\contentsline {paragraph}{The weights do not see the marking.}{112}{table.caption.52}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Silent transitions alone are not the cause.}{112}{table.caption.52}\protected@file@percent }
