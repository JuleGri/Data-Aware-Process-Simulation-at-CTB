\@writefile{toc}{\contentsline {paragraph}{Precision and simulation.}{121}{table.caption.74}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {C.1}{\ignorespaces E2 on the three admissible nets. Rules violated: rules whose violation the language of the net permits, before $\rightarrow $ after the repair (6 (bound): more than four stops, enforced by the stop guard). Sequences with 4 stops: distinct sequences the language permits (5 occur in training). Precision: ETConformance in ProM 6.15 on the discovered net and on the repaired net without silent transitions. Gen.: new test sequences accepted, before $\rightarrow $ after the repair. A4: fitting visits (training and test), accepted training sequences and accepted new test sequences unchanged by the repair. A3: not dominated in precision of the rewritten net and generalisation.}}{122}{table.caption.74}\protected@file@percent }
\newlabel{tab:app_rewritten_funnel}{{C.1}{122}{E2 on the three admissible nets. Rules violated: rules whose violation the language of the net permits, before $\rightarrow $ after the repair (6 (bound): more than four stops, enforced by the stop guard). Sequences with 4 stops: distinct sequences the language permits (5 occur in training). Precision: ETConformance in ProM 6.15 on the discovered net and on the repaired net without silent transitions. Gen.: new test sequences accepted, before $\rightarrow $ after the repair. A4: fitting visits (training and test), accepted training sequences and accepted new test sequences unchanged by the repair. A3: not dominated in precision of the rewritten net and generalisation}{table.caption.74}{}}
\@writefile{lot}{\contentsline {table}{\numberline {C.2}{\ignorespaces Earlier comparison of the three admissible nets, each repaired, rewritten without silent transitions, with the stop guard on the visible transitions; mean over five seeds with [minimum, maximum]. Prec.: ETConformance on the rewritten net (training). Gate: no visit without stop, no overlapping stops of one truck, at most four stops, in every seed. TVD: total-variation distance to the training log (sequences; number of stops per visit). Overr.: guard overrides per run. Unseen: generated visits whose sequence does not occur in the training log. Right: against the test log. Observed test log: TTT median 33, P90 75 minutes.}}{122}{table.caption.75}\protected@file@percent }
\newlabel{tab:app_rewritten_matrix}{{C.2}{122}{Earlier comparison of the three admissible nets, each repaired, rewritten without silent transitions, with the stop guard on the visible transitions; mean over five seeds with [minimum, maximum]. Prec.: ETConformance on the rewritten net (training). Gate: no visit without stop, no overlapping stops of one truck, at most four stops, in every seed. TVD: total-variation distance to the training log (sequences; number of stops per visit). Overr.: guard overrides per run. Unseen: generated visits whose sequence does not occur in the training log. Right: against the test log. Observed test log: TTT median 33, P90 75 minutes}{table.caption.75}{}}
